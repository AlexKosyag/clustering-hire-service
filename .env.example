# ===== PostgreSQL =====
DB_PASSWORD=changeme
POSTGRES_DB=fsp_platform
POSTGRES_USER=fsp

# ===== Redis =====
REDIS_URL=redis://redis:6379

# ===== MinIO =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ===== JWT =====
JWT_SECRET=dev-only-secret-key-change-me-32-chars-min
JWT_REFRESH_SECRET=dev-only-refresh-secret-key-change-me-32

# ===== App =====
NODE_ENV=production
PORT=3000
FRONTEND_URL=http://localhost:8080

# ===== Email (MVP: заглушка, письма логируются) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@fsp-platform.ru

# ===== Embeddings =====
# auto       — каскад: multilingual MiniLM -> all-MiniLM-L6-v2 -> TF-IDF (384 dim)
# tfidf      — только лексический fallback (офлайн, детерминированно)
# transformers — только модель (падает в TF-IDF при ошибке загрузки)
EMBEDDING_PROVIDER=auto

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:3000
