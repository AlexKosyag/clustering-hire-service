// prisma/schema.prisma — Схема данных платформы ФСП
// Источник: docs/modules/database.md (с исправлениями: опечатка vacityId, pgvector)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ПОЛЬЗОВАТЕЛИ ============

enum UserRole {
  CANDIDATE
  EMPLOYER
  ADMIN
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String    @map("password_hash")
  role             UserRole
  isEmailVerified  Boolean   @default(false) @map("is_email_verified")
  emailVerifyToken String?   @map("email_verify_token")
  refreshToken     String?   @map("refresh_token")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  candidateProfile CandidateProfile?
  employerProfile  EmployerProfile?

  @@map("users")
}

// ============ КАНДИДАТЫ ============

enum Specialization {
  BACKEND
  FRONTEND
  FULLSTACK
  MOBILE
  DEVOPS
  DATA_SCIENCE
  QA
  SECURITY
  EMBEDDED
  GAME_DEV
  ML_AI
  DESIGN_UX
  MANAGEMENT
}

enum Grade {
  JUNIOR
  MIDDLE
  MIDDLE_PLUS
  SENIOR
  LEAD
  PRINCIPAL
}

enum TestStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
  PASSED
  UPGRADED
}

model CandidateProfile {
  id         String @id @default(uuid())
  userId     String @unique @map("user_id")

  // Основная информация
  firstName       String?  @map("first_name")
  lastName        String?  @map("last_name")
  middleName      String?  @map("middle_name")
  phone           String?
  city            String?
  bio             String?  @db.Text
  avatarUrl       String?  @map("avatar_url")

  // Профессиональные данные
  specialization Specialization?
  declaredGrade  Grade?   @map("declared_grade") // самооценка
  verifiedGrade  Grade?   @map("verified_grade") // подтверждённый тестом
  stack          String[]
  roles          String[]
  experienceYears Float?  @map("experience_years")
  softSkills     String[] @map("soft_skills")

  // FSP данные
  fspId          String?  @unique @map("fsp_id")
  fspConnectedAt DateTime? @map("fsp_connected_at")

  // Статус тестирования
  testStatus        TestStatus @default(NOT_STARTED) @map("test_status")
  lastTestDate      DateTime?  @map("last_test_date")
  testCooldownUntil DateTime?  @map("test_cooldown_until")
  lastTestScore     Float?     @map("last_test_score")

  // Resume (PDF загрузка — MVP хранит ссылку, парсинг в концепциях)
  resumePdfUrl String? @map("resume_pdf_url")
  resumeParsed Json?   @map("resume_parsed")

  // Настройки приватности
  showEmail          Boolean @default(false) @map("show_email")
  showPhone          Boolean @default(false) @map("show_phone")
  showFullName       Boolean @default(true) @map("show_full_name")
  consentToProcessing Boolean @default(false) @map("consent_to_processing")

  // Последний рассчитанный match score (для сортировки и статистики)
  lastMatchScore Float? @map("last_match_score")

  // Векторное представление для semantic matching (pgvector, пишется через raw SQL)
  profileEmbedding Unsupported("vector(384)")? @map("profile_embedding")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  testSessions TestSession[]
  achievements CandidateAchievement[]
  invitations  Invitation[] @relation("CandidateInvitations")
  dailyTasks   DailyTask[]

  @@index([specialization, verifiedGrade])
  @@index([testStatus])
  @@index([fspId])
  @@map("candidate_profiles")
}

// ============ РАБОТОДАТЕЛИ ============

model EmployerProfile {
  id                String  @id @default(uuid())
  userId            String  @unique @map("user_id")

  companyName        String  @map("company_name")
  companyDescription String? @map("company_description") @db.Text
  industry           String?
  website            String?
  logoUrl            String? @map("logo_url")
  contactPerson      String? @map("contact_person")
  contactEmail       String? @map("contact_email")
  contactPhone       String? @map("contact_phone")

  // Верификация (за рамками MVP)
  isVerified Boolean   @default(false) @map("is_verified")
  verifiedAt DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancies   Vacancy[]
  invitations Invitation[] @relation("EmployerInvitations")
  needs       EmployerNeed[]

  @@map("employer_profiles")
}

// ============ ВАКАНСИИ ============

model Vacancy {
  id             String @id @default(uuid())
  employerId     String @map("employer_id")

  title          String
  description    String @db.Text
  specialization Specialization
  grade          Grade
  stack          String[]
  salaryFrom     Int    @map("salary_from")
  salaryTo       Int    @map("salary_to")

  isActive Boolean   @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employer     EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  invitations  Invitation[]

  @@index([specialization, grade])
  @@index([isActive])
  @@map("vacancies")
}

// ============ ПОТРЕБНОСТИ РАБОТОДАТЕЛЯ ============

model EmployerNeed {
  id             String @id @default(uuid())
  employerId     String @map("employer_id")

  description     String @db.Text
  specialization  Specialization?
  grade           Grade?
  stack           String[]

  needEmbedding Unsupported("vector(384)")? @map("need_embedding")

  createdAt DateTime @default(now()) @map("created_at")

  employer EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId, createdAt])
  @@map("employer_needs")
}

// ============ ПРИГЛАШЕНИЯ ============

enum InvitationStatus {
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Invitation {
  id        String @id @default(uuid())

  employerId  String  @map("employer_id")
  candidateId String  @map("candidate_id")
  vacancyId   String? @map("vacancy_id")

  message  String? @db.Text
  salaryFrom Int   @map("salary_from")
  salaryTo   Int   @map("salary_to")

  status          InvitationStatus @default(SENT)
  statusUpdatedAt DateTime         @default(now()) @map("status_updated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employer  EmployerProfile   @relation("EmployerInvitations", fields: [employerId], references: [id], onDelete: Cascade)
  candidate CandidateProfile  @relation("CandidateInvitations", fields: [candidateId], references: [id], onDelete: Cascade)
  vacancy   Vacancy?          @relation(fields: [vacancyId], references: [id], onDelete: SetNull)

  @@index([candidateId, status])
  @@index([employerId, status])
  @@map("invitations")
}

// ============ ТЕСТИРОВАНИЕ ============

model TestCategory {
  id             String @id @default(uuid())
  name           String @unique
  description    String?
  specialization Specialization

  questions TestQuestion[]
  sessions  TestSession[]

  @@map("test_categories")
}

model TestQuestion {
  id         String @id @default(uuid())
  categoryId String @map("category_id")

  questionType String @map("question_type") // multiple_choice, coding, open_text, scenario

  text          String  @db.Text
  codeSnippet   String? @map("code_snippet") @db.Text
  options       Json?
  correctAnswer String? @map("correct_answer") @db.Text
  explanation   String? @db.Text

  // IRT (3PL) параметры
  difficulty     Float  @default(0.5)
  discrimination Float  @default(1.0)
  guessing       Float  @default(0.25)

  // Anti-cheat
  isUnique Boolean  @default(false) @map("is_unique")
  poolTag  String?  @map("pool_tag")

  category TestCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  answers  TestAnswer[]

  @@index([categoryId, difficulty])
  @@map("test_questions")
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  TIMED_OUT
  ABANDONED
}

model TestSession {
  id         String @id @default(uuid())
  candidateId String @map("candidate_id")
  categoryId String @map("category_id")

  status            SessionStatus @default(IN_PROGRESS)
  startedAt         DateTime      @default(now()) @map("started_at")
  completedAt       DateTime?     @map("completed_at")
  timeLimitMinutes  Int           @default(60) @map("time_limit_minutes")

  score     Float?
  rawScore  Float? @map("raw_score")
  maxScore  Float? @map("max_score")
  gradeBefore Grade? @map("grade_before")
  gradeAfter  Grade? @map("grade_after")
  recommendation String? // PASS | FAIL | UPGRADE

  // Anti-cheat результат
  cheatFlags    String[] @map("cheat_flags")
  isSuspicious  Boolean  @default(false) @map("is_suspicious")

  // CAT параметры
  currentDifficulty Float  @default(0.5) @map("current_difficulty")
  thetaEstimate     Float? @map("theta_estimate")

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  category  TestCategory     @relation(fields: [categoryId], references: [id])
  answers   TestAnswer[]

  @@index([candidateId, status])
  @@map("test_sessions")
}

model TestAnswer {
  id        String @id @default(uuid())
  sessionId String  @map("session_id")
  questionId String @map("question_id")

  answerText       String? @map("answer_text") @db.Text
  isCorrect        Boolean?
  score            Float?
  timeSpentSeconds Int?    @map("time_spent_seconds")

  answeredAt DateTime @default(now()) @map("answered_at")

  session  TestSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question TestQuestion @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@map("test_answers")
}

// ============ ДОСТИЖЕНИЯ ФСП ============

model FSPAchievement {
  id            String @id @default(uuid())
  name          String
  description   String?
  category      String // competition, event, certification
  year          Int?
  place         String?
  points        Int    @default(0)

  candidateLinks CandidateAchievement[]

  @@index([category, year])
  @@map("fsp_achievements")
}

model CandidateAchievement {
  id            String @id @default(uuid())
  candidateId   String @map("candidate_id")
  achievementId String @map("achievement_id")
  verifiedAt    DateTime @default(now()) @map("verified_at")

  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  achievement FSPAchievement   @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([candidateId, achievementId])
  @@map("candidate_achievements")
}

// ============ ЕЖЕДНЕВНЫЕ ЗАДАНИЯ (концепция, таблица создаётся заранее) ============

enum DailyTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  EXPIRED
}

model DailyTask {
  id          String @id @default(uuid())
  candidateId String @map("candidate_id")

  title       String
  description String @db.Text
  difficulty  String // easy, medium, hard
  expectedTimeMinutes Int @map("expected_time_minutes")

  status          DailyTaskStatus @default(PENDING)
  candidateAnswer String?         @map("candidate_answer") @db.Text
  score           Float?

  assignedAt DateTime  @default(now()) @map("assigned_at")
  dueAt      DateTime  @map("due_at")
  completedAt DateTime? @map("completed_at")

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, status])
  @@map("daily_tasks")
}
